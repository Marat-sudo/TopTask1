<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/LemonChiffon"
    android:orientation="vertical">

    <TextView
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="викторина, надеюсь её хотя бы проверят"
        app:layout_constraintTop_toTopOf="parent"
        android:textSize="20sp"
        android:layout_marginTop="30dp"
        android:textColor="@color/material_dynamic_primary40"
        android:gravity="center">

    </TextView>

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="нажмите нижнию кнопку нажать и игра начнется"
        app:layout_constraintTop_toTopOf="@id/head"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="150dp"
        android:visibility="invisible"
        android:textSize="20sp">
    </TextView>

    <Button
        android:id="@+id/answer1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="175dp"
        android:minLines="3"
        android:maxLines="3"
        android:layout_marginTop="50dp"
        android:layout_marginStart="16dp"
        android:text="ответ 1"
        android:textSize="16sp"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/text"
        app:layout_constraintStart_toStartOf="parent">

    </Button>

    <Button
        android:id="@+id/answer2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="175dp"
        android:minLines="3"
        android:maxLines="3"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/answer1"

        android:text="ответ 2"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent">

    </Button>

    <Button
        android:id="@+id/answer3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="175dp"
        android:minLines="3"
        android:maxLines="3"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="50dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="ответ 3"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/text">

    </Button>

    <Button
        android:id="@+id/answer4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:maxLines="3"
        android:maxWidth="175dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="ответ 4"
        android:visibility="invisible"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/answer3"
        app:layout_constraintEnd_toEndOf="parent">

    </Button>


    <Button
        android:id="@+id/startNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text"
        android:layout_marginTop="230dp"
        android:text="начать"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:backgroundTint="@color/material_dynamic_primary40"
        >

    </Button>








</androidx.constraintlayout.widget.ConstraintLayout>




